{
  "name": "inventory-erp-backend",
  "version": "1.0.0",
  "description": "Inventory ERP + CRM backend",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "npx prisma generate",
    "start": "node -e \"require('ts-node').register({transpileOnly:true}); require('./src/server.ts')\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "seed": "node prisma/seed-pg.mjs",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "db:constraints": "ts-node prisma/apply-constraints.ts",
    "db:constraints:prod": "node dist/prisma/apply-constraints.js",
    "db:setup": "prisma migrate deploy && node dist/prisma/apply-constraints.js && npm run seed",
    "apply-schema": "node prisma/apply-schema.mjs",
    "start:prod": "NODE_TLS_REJECT_UNAUTHORIZED=0 node --dns-result-order=ipv4first prisma/apply-schema.mjs && NODE_TLS_REJECT_UNAUTHORIZED=0 node --dns-result-order=ipv4first prisma/seed-pg.mjs && NODE_TLS_REJECT_UNAUTHORIZED=0 DATABASE_URL=\"postgresql://postgres.xukbgkwagjtzxoobcyuk:Harbans1073!@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require\" CORS_ORIGINS=\"*\" node --dns-result-order=ipv4first -r ts-node/register/transpile-only src/server.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prisma": "^5.22.0",
    "socket.io": "^4.8.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1"
  }
}
