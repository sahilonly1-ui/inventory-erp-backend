NODE_ENV=development
PORT=8080

# Postgres (Railway injects DATABASE_URL automatically in prod)
DATABASE_URL=postgresql://user:password@localhost:5432/erp?schema=public

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_min_32_chars_long_secret_value
JWT_REFRESH_SECRET=change_me_min_32_chars_long_secret_value_2
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
PASSWORD_RESET_TTL_MIN=30

# Security
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# First-run admin (used by `npm run seed`)
BOOTSTRAP_ADMIN_EMAIL=admin@itecharena.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2025

# Outgoing mail (used for the nightly stock-in backup).
# Leave unset to disable mail entirely — the app still runs.
# For Gmail use an App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_sender@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=iTechArena ERP <your_sender@gmail.com>

# Nightly stock-in backup
BACKUP_EMAIL_TO=Harbans22@gmail.com
BACKUP_CRON=30 22 * * *
BACKUP_TZ=Asia/Kolkata
BACKUP_ENABLED=true
