// =============================================================================
// INVENTORY ERP + CRM  —  schema.prisma  (Phase 1 + Phase 2)
// Changes vs Phase 1:
//   - REMOVED AccessoryInventory (accessories = products with imeiRequired=false)
//   - ADDED PasswordResetToken, LoginAudit
//   - Partial unique indexes now also cover sku, imei2, email (see notes)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------------------------- ENUMS
enum TransactionType {
  OPENING
  STOCK_IN
  STOCK_OUT
  MARKETPLACE_DISPATCH
  RETURN
  CANCELLATION
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum ImeiStatus {
  IN_STOCK
  SOLD
  RETURNED
  OPEN_BOX
  DAMAGED
  CANCELLED
  BLOCKED
}

enum Marketplace {
  AMAZON
  FLIPKART
  JIOMART
  PRIME
  OTHER
}

enum MarketplaceOrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  DELIVERED
  CANCELLED
  RETURNED
}

enum OpenBoxGrade {
  A
  B
  C
  D
}

enum ReportType {
  STOCK_IN
  STOCK_OUT
  VENDOR
  MARKETPLACE
  IMEI
  PROFIT
  OPEN_BOX
  INVENTORY_VALUATION
  DEAD_STOCK
  LOW_STOCK
}

enum ReportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum ImportType {
  STOCK_IN
  STOCK_OUT
  PRODUCTS
  IMEI
  VENDORS
}

enum ImportStatus {
  PENDING
  VALIDATING
  PARTIAL
  COMPLETED
  REJECTED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  EXPORT
  IMPORT
}

enum NotificationType {
  LOW_STOCK
  DEAD_STOCK
  IMPORT_DONE
  EXPORT_DONE
  SYSTEM
}

// --------------------------------------------------------------------------- AUTH / RBAC
model User {
  id           String    @id @default(uuid())
  email        String // partial-unique WHERE is_deleted=false (migration)
  passwordHash String
  fullName     String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  roles         Role[]               @relation("UserRoles")
  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]
  loginAudits   LoginAudit[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@index([email])
  @@index([isDeleted])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model LoginAudit {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  success   Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@map("login_audits")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  users       User[]       @relation("UserRoles")
  permissions Permission[] @relation("RolePermissions")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique
  description String?
  roles       Role[]  @relation("RolePermissions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

// --------------------------------------------------------------------------- PRODUCT MASTER
model ProductCategory {
  id       String            @id @default(uuid())
  name     String
  parentId String?
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@index([parentId])
  @@map("product_categories")
}

model Product {
  id          String           @id @default(uuid())
  ean         String
  sku         String   @default("")
  model       String
  brand       String
  brandId     String?
  brandRef    Brand?           @relation(fields: [brandId], references: [id])
  categoryId  String?
  category    ProductCategory? @relation(fields: [categoryId], references: [id])
  description String?
  status      ProductStatus    @default(ACTIVE)
  images      String[]         @default([])
  minStock    Int              @default(0)

  costPrice    Decimal @db.Decimal(12, 2)
  sellingPrice Decimal @db.Decimal(12, 2)
  gstRate      Decimal @db.Decimal(5, 2)
  hsnCode      String?

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  imeiRequired   Boolean @default(false)
  serialRequired Boolean @default(false)

  transactions InventoryTransaction[]
  stockLevels  StockLevel[]
  imeiUnits    ImeiInventory[]
  openBoxUnits OpenBoxInventory[]
  attributes   ProductAttribute[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@index([ean])
  @@index([brand])
  @@index([brandId])
  @@index([categoryId])
  @@index([status])
  @@index([isDeleted])
  @@map("products")
}

// --------------------------------------------------------------------------- VENDORS
model Vendor {
  id              String  @id @default(uuid())
  name            String
  code            String  @unique
  normalizedName  String? // lowercase + no-spaces, used for dedup matching
  state           String? // mandatory on new creation
  contactPerson   String?
  phone           String?
  email           String?
  gstin           String?
  address         String?
  notes           String?

  products     Product[]
  transactions InventoryTransaction[]
  imeiUnits    ImeiInventory[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@map("vendors")
}

// --------------------------------------------------------------------------- WAREHOUSES
model Warehouse {
  id      String  @id @default(uuid())
  name    String
  code    String  @unique
  address String?

  locations    StockLocation[]
  transactions InventoryTransaction[]
  stockLevels  StockLevel[]
  imeiUnits    ImeiInventory[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@map("warehouses")
}

model StockLocation {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  binCode     String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@unique([warehouseId, binCode])
  @@map("stock_locations")
}

// --------------------------------------------------------------------------- INVENTORY ENGINE
model InventoryTransaction {
  id          String          @id @default(uuid())
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  type        TransactionType
  quantity    Int // SIGNED delta: +inbound, -outbound
  unitCost    Decimal?        @db.Decimal(12, 2)

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  referenceType String?
  referenceId   String?
  remarks       String?

  createdAt DateTime @default(now())
  createdBy String?

  @@index([productId, warehouseId])
  @@index([type])
  @@index([createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_transactions")
}

model StockLevel {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  quantity    Int       @default(0) // CHECK (quantity >= 0) via migration

  updatedAt DateTime @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("stock_levels")
}

// --------------------------------------------------------------------------- IMEI ENGINE
model ImeiInventory {
  id          String     @id @default(uuid())
  productId   String
  product     Product    @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id])
  imei1       String // partial-unique WHERE is_deleted=false (migration)
  imei2       String? // partial-unique WHERE is_deleted=false AND imei2 IS NOT NULL
  status      ImeiStatus @default(IN_STOCK)
  imeiType    String @default("NIL") // NIL | OPEN_BOX | DEMO | SECOND_IMEI
  swiped      Boolean @default(false)
  swipedAt    DateTime? // timestamp when swiped was last toggled on
  supplierId  String?
  supplier    Vendor? @relation(fields: [supplierId], references: [id])
  purchaseDate DateTime?
  invoiceNo   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@index([productId])
  @@index([status])
  @@index([imei1])
  @@map("imei_inventory")
}

// --------------------------------------------------------------------------- OPEN BOX
model OpenBoxInventory {
  id           String       @id @default(uuid())
  productId    String
  product      Product      @relation(fields: [productId], references: [id])
  imei         String?
  grade        OpenBoxGrade
  testingNotes String?
  remarks      String?
  images       String[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@index([productId])
  @@index([grade])
  @@map("open_box_inventory")
}

// --------------------------------------------------------------------------- MARKETPLACE
model MarketplaceOrder {
  id             String                 @id @default(uuid())
  marketplace    Marketplace
  orderNumber    String
  shipmentNumber String?
  status         MarketplaceOrderStatus @default(PENDING)

  items        MarketplaceOrderItem[]
  cancellation Cancellation?
  returns      Return[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@unique([marketplace, orderNumber])
  @@index([status])
  @@map("marketplace_orders")
}

model MarketplaceOrderItem {
  id       String           @id @default(uuid())
  orderId  String
  order    MarketplaceOrder @relation(fields: [orderId], references: [id])
  sku      String
  ean      String
  quantity Int
  imei     String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("marketplace_order_items")
}

model Return {
  id        String            @id @default(uuid())
  orderId   String?
  order     MarketplaceOrder? @relation(fields: [orderId], references: [id])
  productId String?
  imei      String?
  quantity  Int
  reason    String?

  createdAt DateTime  @default(now())
  createdBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@index([orderId])
  @@map("returns")
}

model Cancellation {
  id      String           @id @default(uuid())
  orderId String           @unique
  order   MarketplaceOrder @relation(fields: [orderId], references: [id])
  reason  String?

  createdAt DateTime  @default(now())
  createdBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@map("cancellations")
}

// --------------------------------------------------------------------------- AUDIT / REPORTS / IMPORTS / NOTIFY
model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  action     AuditAction
  entityName String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([entityName, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ReportExport {
  id          String       @id @default(uuid())
  type        ReportType
  status      ReportStatus @default(QUEUED)
  params      Json?
  filePath    String?
  requestedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@map("report_exports")
}

model ImportLog {
  id          String       @id @default(uuid())
  type        ImportType
  status      ImportStatus @default(PENDING)
  fileName    String
  totalRows   Int          @default(0)
  successRows Int          @default(0)
  failedRows  Int          @default(0)
  errors      Json?
  importedBy  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@map("import_logs")
}

model Notification {
  id      String           @id @default(uuid())
  userId  String?
  type    NotificationType
  title   String
  message String
  isRead  Boolean          @default(false)
  meta    Json?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// =============================================================================
// RAW MIGRATION NOTES (Prisma DSL cannot express partial indexes / CHECK)
// Add these to the first migration's SQL:
//
//   CREATE UNIQUE INDEX uq_users_email   ON users(email)            WHERE "isDeleted" = false;
//   CREATE UNIQUE INDEX uq_products_ean  ON products(ean)           WHERE "isDeleted" = false;
//   CREATE UNIQUE INDEX uq_products_sku  ON products(sku)           WHERE "isDeleted" = false;
//   CREATE UNIQUE INDEX uq_imei_imei1    ON imei_inventory(imei1)   WHERE "isDeleted" = false;
//   CREATE UNIQUE INDEX uq_imei_imei2    ON imei_inventory(imei2)   WHERE "isDeleted" = false AND imei2 IS NOT NULL;
//   ALTER TABLE stock_levels ADD CONSTRAINT chk_stock_nonneg CHECK (quantity >= 0);
// =============================================================================

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
  OPEN_BOX_ONLY
  BLOCKED
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@map("brands")
}

model ProductAttribute {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, key])
  @@map("product_attributes")
}

model SavedView {
  id         String   @id @default(uuid())
  userId     String
  name       String
  filters    Json
  columns    Json
  sortBy     String?
  sortDir    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("saved_views")
}
